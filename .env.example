# ============================================================
# Copy to .env.local (git-ignored) and fill in your own values.
# NONE of these may be prefixed NEXT_PUBLIC_ — the token is a
# secret and must stay on the server.
# ============================================================

# --- WhatsApp Cloud API (Meta) ---
# From Meta for Developers > your app > WhatsApp > API Setup.
# "Phone number ID" of the SENDER number (not the number itself).
WHATSAPP_PHONE_NUMBER_ID=

# Permanent access token for a System User with whatsapp_business_messaging.
# The temporary 24h token from API Setup works for testing only.
WHATSAPP_ACCESS_TOKEN=

# Who receives the lead alerts. Optional — defaults to `whatsapp` in
# app/lib/business.js. Digits only, country code first, comma separated
# for more than one recipient.
# WHATSAPP_TO=923116229099

# Name of the APPROVED message template (Meta > WhatsApp Manager > Templates).
# Must have exactly 6 body variables, in this order:
#   {{1}} name  {{2}} email  {{3}} phone  {{4}} service  {{5}} zip  {{6}} notes
# WHATSAPP_TEMPLATE_NAME=new_quote_request

# Template language code, exactly as shown in WhatsApp Manager (e.g. en, en_US).
# WHATSAPP_TEMPLATE_LANG=en

# Graph API version. Bump to whatever is current in your Meta dashboard.
# WHATSAPP_API_VERSION=v21.0

# Where the CrewDesk backup copy is posted. Only override this for testing.
# CREWDESK_ENDPOINT=

# --- IndexNow (instant indexing for Bing, Yandex, Seznam, Naver...) ---
# Must match the key file committed at public/<key>.txt. The key itself is
# public by design; it only proves the submitter controls this host.
INDEXNOW_KEY=1744865e55b28c38ab2c8419ade927b6

# Optional bearer token that POST /api/indexnow requires. Falls back to the
# IndexNow key when unset. Set a separate random value in production.
# INDEXNOW_SUBMIT_TOKEN=

# --- Google reviews ---
# Place ID of the Google Business Profile. When set, the site shows a
# "See our Google reviews" section that links to the live reviews. Public
# by nature, so the NEXT_PUBLIC_ prefix is correct here.
# NEXT_PUBLIC_GBP_PLACE_ID=
